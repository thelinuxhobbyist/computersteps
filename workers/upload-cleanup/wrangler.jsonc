{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutri-upload-cleanup",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS_BUCKET",
      "bucket_name": "tutri-uploaded-files"
    }
  ]
}